// --- NIRI BLUR START ---
// 顶层的blur配置，细节调整blur的效果
blur {
    passes 2
    offset 2
    noise 0.02
    saturation 1.5
}
// 全局窗口规则。让所有普通窗口以xray的形式显示blur。
window-rule {
    background-effect {
        xray true
        blur true
    }
}
// 浮动窗口
window-rule {
    match is-floating=true
    background-effect {
        xray true
        blur true
    }
}
// fuzzel 专属的 layer 规则
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 8
    background-effect {
        xray false
        blur true
    }
}
// 终端窗口：真实模糊（模糊后面的窗口内容，而不是穿透到壁纸）
window-rule {
    match app-id="kitty"
    match app-id="quickterminal"
    match app-id="opencode"
    background-effect {
        xray false
        blur true
    }
}
// DMS 弹窗：只透明，不模糊（避免打开/关闭时的全屏糊闪与残影）。
// 透明度由 DMS 的 popupTransparency 控制。
// --- NIRI BLUR END ---
