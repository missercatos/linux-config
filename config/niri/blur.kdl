// --- NIRI BLUR START ---
// 顶层的blur配置，细节调整blur的效果
blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}
// 全局窗口规则。让所有普通窗口以xray的形式显示blur。
window-rule {
    background-effect {
        xray true
        blur true
    }
}
// 浮动窗口
window-rule {
    match is-floating=true
    background-effect {
        xray true
        blur true
    }
}
// fuzzel 专属的 layer 规则
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 8
    background-effect {
        xray false
        blur true
    }
}
// 终端窗口：真实模糊（模糊后面的窗口内容，而不是穿透到壁纸）
window-rule {
    match app-id="kitty"
    match app-id="quickterminal"
    match app-id="opencode"
    background-effect {
        xray false
        blur true
    }
}
// DMS 弹窗/组件：只模糊弹窗本体。
// 注意：只匹配单段命名空间（不带 :background），并且不包含
// dms:blurwallpaper（总览壁纸）和 dms:niri-overview-spotlight（总览启动器），
// 这样 mod+O 总览以及全屏背景层都不会被影响。
layer-rule {
    match namespace="^dms:(bar|dock|dash|control-center|spotlight|spotlight-bar|notification-center-modal|power-menu|system-updater|processlist|notepad|keybinds|keybinds-modal|window-rules|workspace-rename|widget|welcome|file|mux|tmux|wallpaper|profile|sessions|outputs|night|brightness|color-picker|theme|clipboard|tray|toast|settings|plugins|audio|bluetooth|network|power-profile|display|screenshot)$"
    background-effect {
        xray false
        blur true
    }
}
// --- NIRI BLUR END ---
