#!/bin/bash
# setup-user-quickshell.sh
# 在没有 root 权限时，把官方 Quickshell 0.3.1 安装到 ~/.local/quickshell，
# 并在 ~/.local/bin 放置 qs / quickshell 影子命令，供 DMS 使用。
# 背景：noctalia-qs 这个 fork 与 DMS 1.6.2 的 IPC/QML API 不兼容，
#       会导致 DMS 大部分 IPC 目标注册失败（工具栏按钮/快捷键失效）。
set -euo pipefail

BASE="https://mirrors.sjtug.sjtu.edu.cn/archlinux/extra/os/x86_64"
DEST="$HOME/.local/quickshell"
BIN="$HOME/.local/bin"

mkdir -p "$BIN"
rm -rf "$DEST"; mkdir -p "$DEST"

for p in "quickshell-0.3.1-1" "cpptrace-1.0.4-2" "libdwarf-1:2.3.3-1"; do
    echo ">>> download $p"
    curl -fL --retry 3 -o "/tmp/${p}.pkg" "$BASE/${p}-x86_64.pkg.tar.zst"
    tar -xf "/tmp/${p}.pkg" -C "$DEST"
done

cat > "$BIN/quickshell-official" << 'EOS'
#!/bin/bash
export LD_LIBRARY_PATH="$HOME/.local/quickshell/usr/lib:$LD_LIBRARY_PATH"
export QML2_IMPORT_PATH="$HOME/.local/quickshell/usr/lib/qt6/qml:$QML2_IMPORT_PATH"
export QT_PLUGIN_PATH="$HOME/.local/quickshell/usr/lib/qt6/plugins:$QT_PLUGIN_PATH"
exec "$HOME/.local/quickshell/usr/bin/quickshell" "$@"
EOS
chmod +x "$BIN/quickshell-official"
ln -sf "$BIN/quickshell-official" "$BIN/qs"
ln -sf "$BIN/quickshell-official" "$BIN/quickshell"

echo ">>> verify: $("$BIN/qs" --version)"
echo ">>> done. 重新登录 niri，或在当前会话执行: dms run --daemon"
